[debug] [2026-08-14T09:53:18.076Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/batchfee-477b8/rulesets {"name":"projects/batchfee-477b8/rulesets/ba9c8c25-903c-406b-939a-552789a026e6","source":{"files":[{"content":"rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    // The Android client never talks to Storage directly. Cloud Functions uses\n    // the Admin SDK after Auth + App Check + tenant/role authorization, and it\n    // returns a short-lived V4 signed URL only for an authorized private read.\n    // Institute logos use a Firebase download token generated server-side so\n    // legacy direct image/PDF rendering remains compatible without client write access.\n    match /{allPaths=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-08-14T09:53:17.083487Z","metadata":{"services":["firebase.storage"]}}
