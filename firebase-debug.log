[debug] [2026-08-14T09:53:23.185Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/batchfee-477b8/rulesets {"name":"projects/batchfee-477b8/rulesets/c1b432ae-7a84-43c1-98bb-f853310a29be","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // -----------------------------------------------------------------\n    // Identity and tenant helpers\n    // -----------------------------------------------------------------\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function institutePath(instituteId) {\n      return /databases/$(database)/documents/institutes/$(instituteId);\n    }\n\n    function staffPath(instituteId) {\n      return /databases/$(database)/documents/institutes/$(instituteId)/staffs/$(request.auth.uid);\n    }\n\n    function studentPath(instituteId, studentId) {\n      return /databases/$(database)/documents/institutes/$(instituteId)/students/$(studentId);\n    }\n\n    function managedUserPath() {\n      return /databases/$(database)/documents/app_users/$(request.auth.uid);\n    }\n\n    // Privileged roles are trusted only from app_users. Institute documents are\n    // owner-editable profile records and must never be a source of global authority.\n    function isSuperAdmin() {\n      let path = managedUserPath();\n      return isSignedIn()\n        && exists(path)\n        && (get(path).data.role in ['SuperAdmin', 'superAdmin', 'super_admin']\n          || get(path).data.platformRole == 'root')\n        && (!('status' in get(path).data) || get(path).data.status == 'active');\n    }\n\n    // Non-root platform roles may inspect the operational directory and its\n    // immutable audit trail. They never receive a client-side mutation path.\n    function isPlatformDataReader() {\n      let path = managedUserPath();\n      return isSignedIn()\n        && exists(path)\n        && (get(path).data.role in ['SuperAdmin', 'superAdmin', 'super_admin']\n          || get(path).data.platformRole in ['root', 'billing', 'support', 'operations', 'read_only'])\n        && (!('status' in get(path).data) || get(path).data.status == 'active');\n    }\n\n    function isOwner(instituteId) {\n      let path = institutePath(instituteId);\n      return isSignedIn()\n        && ((!exists(path) && request.auth.uid == instituteId)\n          || (exists(path)\n            && (('ownerUid' in get(path).data && get(path).data.ownerUid == request.auth.uid)\n              || (!('ownerUid' in get(path).data) && request.auth.uid == instituteId))));\n    }\n\n    function isManagedInstituteOwner(instituteId) {\n      let path = managedUserPath();\n      return isSignedIn()\n        && exists(path)\n        && get(path).data.instituteId == instituteId\n        && get(path).data.role in ['InstituteOwner', 'owner']\n        && (!('status' in get(path).data) || get(path).data.status == 'active');\n    }\n\n    function isManagedInstituteAdmin(instituteId) {\n      let path = managedUserPath();\n      return isSignedIn()\n        && exists(path)\n        && get(path).data.instituteId == instituteId\n        && get(path).data.role in ['InstituteAdmin', 'admin', 'instituteAdmin', 'institute_admin']\n        && (!('status' in get(path).data) || get(path).data.status == 'active');\n    }\n\n    function isInstitutePrincipal(instituteId) {\n      return isInstituteEnabledForStaff(instituteId)\n        && (isOwner(instituteId) || isManagedInstituteOwner(instituteId)\n          || isManagedInstituteAdmin(instituteId));\n    }\n\n    function isInstituteEnabledForStaff(instituteId) {\n      let path = institutePath(instituteId);\n      return exists(path)\n        && (!('isActive' in get(path).data) || get(path).data.isActive == true);\n    }\n\n    // The period end is the source of truth for entitlement. A scheduled\n    // backend task updates the display status after this rule has already\n    // stopped operational access.\n    function hasActiveSubscription(instituteId) {\n      let path = institutePath(instituteId);\n      return exists(path)\n        && get(path).data.isActive == true\n        && get(path).data.currentPeriodEndMs is int\n        && get(path).data.currentPeriodEndMs > request.time.toMillis()\n        && get(path).data.subscriptionStatus in ['trial', 'active'];\n    }\n\n    function isActiveInstitutePrincipal(instituteId) {\n      return isInstitutePrincipal(instituteId) && hasActiveSubscription(instituteId);\n    }\n\n    // A staff account is authorised only while both the institute and staff\n    // records are active. Missing, inactive, blocked, or archived records fail closed.\n    function isActiveStaff(instituteId) {\n      let path = staffPath(instituteId);\n      return isSignedIn()\n        && hasActiveSubscription(instituteId)\n        && exists(path)\n        && get(path).data.status == 'active'\n        && (!('archivedAtMs' in get(path).data) || get(path).data.archivedAtMs == null);\n    }\n\n    // Staff permissions are currently stored as a normalized comma-separated\n    // string. Match complete tokens so similarly named permissions cannot collide.\n    function hasStaffPermission(instituteId, permission) {\n      let path = staffPath(instituteId);\n      return isActiveStaff(instituteId)\n        && get(path).data.permissions is string\n        && get(path).data.permissions.matches('(^|.*,)' + permission + '(,.*|$)');\n    }\n\n    function hasActiveStudentToken() {\n      return isSignedIn()\n        && request.auth.token.keys().hasAll([\n          'student', 'studentId', 'instituteId', 'studentSessionExpiresAt'\n        ])\n        && request.auth.token.student == true\n        && request.auth.token.studentId is string\n        && request.auth.token.instituteId is string\n        && request.auth.token.studentSessionExpiresAt is int\n        && request.auth.token.studentSessionExpiresAt > request.time.toMillis();\n    }\n\n    function isStudentAuthRequest() {\n      return isSignedIn()\n        && request.auth.token.keys().hasAny(['student'])\n        && request.auth.token.student == true;\n    }\n\n    // Student authority needs all three bindings: short-lived server claims, the\n    // claimed institute, and a live student document linked to the Firebase UID.\n    function isStudentOf(instituteId) {\n      let path = studentPath(instituteId, request.auth.token.studentId);\n      return hasActiveStudentToken()\n        && request.auth.token.instituteId == instituteId\n        && hasActiveSubscription(instituteId)\n        && exists(path)\n        && get(path).data.firebaseUid == request.auth.uid\n        && get(path).data.isAppAccessEnabled == true\n        && get(path).data.status == 'active'\n        && (!('archivedAtMs' in get(path).data) || get(path).data.archivedAtMs == null);\n    }\n\n    function isStudentRecordOwner(instituteId, studentId) {\n      return isStudentOf(instituteId) && request.auth.token.studentId == studentId;\n    }\n\n    function studentCredentialFields() {\n      return [\n        'studentPasswordHash',\n        'appAccessEmail',\n        'appAccessPassword',\n        'passwordHash',\n        'passwordSalt',\n        'passwordVerifier',\n        'virtualEmail',\n        'authEmail'\n      ];\n    }\n\n    function studentDocumentHasNoCredentialFields(data) {\n      return !data.keys().hasAny(studentCredentialFields());\n    }\n\n    // This is the complete document schema exposed to an unauthenticated\n    // registration visitor. Keep private institute fields out of this separate\n    // collection; Firestore rules cannot redact individual fields on a read.\n    function validPublicRegistrationProfile() {\n      return request.resource.data.keys().hasOnly([\n          'instituteId', 'instituteName', 'slug', 'phone', 'profilePhotoUri', 'updatedAtMs'\n        ])\n        && request.resource.data.instituteId is string\n        && request.resource.data.instituteId.size() > 0\n        && request.resource.data.instituteId.size() <= 128\n        && request.resource.data.instituteName is string\n        && request.resource.data.instituteName.size() > 0\n        && request.resource.data.instituteName.size() <= 120\n        && request.resource.data.slug is string\n        && request.resource.data.slug.size() > 0\n        && request.resource.data.slug.size() <= 80\n        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')\n        && (!('phone' in request.resource.data)\n          || request.resource.data.phone == null\n          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))\n        && (!('profilePhotoUri' in request.resource.data)\n          || request.resource.data.profilePhotoUri == null\n          || (request.resource.data.profilePhotoUri is string\n            && request.resource.data.profilePhotoUri.size() <= 2048))\n        && request.resource.data.updatedAtMs is int;\n    }\n\n    function studentCreateHasNoAuthFields() {\n      return studentDocumentHasNoCredentialFields(request.resource.data)\n        && !request.resource.data.keys().hasAny([\n          'firebaseUid', 'isAppAccessEnabled'\n        ]);\n    }\n\n    function studentAuthFieldsAreUnchanged() {\n      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n          'firebaseUid',\n          'isAppAccessEnabled',\n          'studentPasswordHash',\n          'appAccessEmail',\n          'appAccessPassword',\n          'passwordHash',\n          'passwordSalt',\n          'passwordVerifier',\n          'virtualEmail',\n          'authEmail'\n        ])\n        && studentDocumentHasNoCredentialFields(resource.data)\n        && studentDocumentHasNoCredentialFields(request.resource.data);\n    }\n\n    function canReadStudentData(instituteId) {\n      return hasStaffPermission(instituteId, 'view_student')\n        || hasStaffPermission(instituteId, 'manage_student')\n        || hasStaffPermission(instituteId, 'view_batch')\n        || hasStaffPermission(instituteId, 'manage_batch')\n        || hasStaffPermission(instituteId, 'view_fee_summary')\n        || hasStaffPermission(instituteId, 'collect_fee')\n        || hasStaffPermission(instituteId, 'send_due_message')\n        || hasStaffPermission(instituteId, 'take_attendance')\n        || hasStaffPermission(instituteId, 'view_attendance_reports')\n        || hasStaffPermission(instituteId, 'view_reports')\n        || hasStaffPermission(instituteId, 'manage_exams')\n        || hasStaffPermission(instituteId, 'generate_id_cards')\n        || hasStaffPermission(instituteId, 'birthday_reminders');\n    }\n\n    function canReadBatchData(instituteId) {\n      return hasStaffPermission(instituteId, 'view_batch')\n        || hasStaffPermission(instituteId, 'manage_batch')\n        || hasStaffPermission(instituteId, 'view_student')\n        || hasStaffPermission(instituteId, 'manage_student')\n        || hasStaffPermission(instituteId, 'view_fee_summary')\n        || hasStaffPermission(instituteId, 'collect_fee')\n        || hasStaffPermission(instituteId, 'take_attendance')\n        || hasStaffPermission(instituteId, 'view_attendance_reports')\n        || hasStaffPermission(instituteId, 'view_reports')\n        || hasStaffPermission(instituteId, 'manage_exams');\n    }\n\n    function canReadFinanceData(instituteId) {\n      return hasStaffPermission(instituteId, 'view_fee_summary')\n        || hasStaffPermission(instituteId, 'collect_fee')\n        || hasStaffPermission(instituteId, 'send_due_message')\n        || hasStaffPermission(instituteId, 'view_reports');\n    }\n\n    function canReadFinancialRecord(instituteId, studentId) {\n      return isStudentRecordOwner(instituteId, studentId)\n        || (!isStudentAuthRequest()\n          && (isSuperAdmin()\n            || isActiveInstitutePrincipal(instituteId)\n            || canReadFinanceData(instituteId)));\n    }\n\n    function canReadAttendanceData(instituteId) {\n      return hasStaffPermission(instituteId, 'take_attendance')\n        || hasStaffPermission(instituteId, 'view_attendance_reports')\n        || hasStaffPermission(instituteId, 'view_reports');\n    }\n\n    function ownerUpdateTouchesOnlySafeFields() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n        'instituteName',\n        'name',\n        'ownerName',\n        'email',\n        'phone',\n        'address',\n        'whatsappNumber',\n        'profilePhotoUri',\n        'instituteCode',\n        'lastActiveAt'\n      ]);\n    }\n\n    function ownerUpdateHasValidCounters() {\n      let changed = request.resource.data.diff(resource.data).affectedKeys();\n      return (!changed.hasAny(['studentCount'])\n          || (request.resource.data.studentCount is int && request.resource.data.studentCount >= 0))\n        && (!changed.hasAny(['staffCount'])\n          || (request.resource.data.staffCount is int && request.resource.data.staffCount >= 0))\n        && (!changed.hasAny(['batchCount'])\n          || (request.resource.data.batchCount is int && request.resource.data.batchCount >= 0))\n        && (!changed.hasAny(['lastActiveAt'])\n          || (request.resource.data.lastActiveAt is int && request.resource.data.lastActiveAt >= 0));\n    }\n\n    // Subscription entitlement, access state, and limits are modified only by\n    // the App Check-protected subscription callable. A Super Admin may still\n    // edit normal institute profile fields directly, but cannot bypass the\n    // server-side quote, renewal, duplicate-payment, and audit controls.\n    function superAdminClientUpdateAvoidsSubscriptionControls() {\n      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([\n        'trialEndDate',\n        'currentPeriodEndMs',\n        'subscriptionStatus',\n        'preBlockSubscriptionStatus',\n        'isActive',\n        'studentLimit',\n        'staffLimit',\n        'currentPlanId',\n        'subscriptionExpiredAtMs'\n      ]);\n    }\n\n    function validOwnerInstituteCreate(instituteId) {\n      let data = request.resource.data;\n      let nowMs = request.time.toMillis();\n      let trialDurationMs = 2592000000;\n      return isOwner(instituteId)\n        && data.keys().hasAll([\n          'instituteName', 'ownerName', 'email', 'role', 'createdAt',\n          'isActive', 'trialEndDate', 'currentPeriodEndMs', 'currentPlanId',\n          'subscriptionStatus', 'studentLimit', 'staffLimit',\n          'studentCount', 'staffCount', 'batchCount'\n        ])\n        && data.keys().hasOnly([\n          'instituteName', 'ownerName', 'email', 'whatsappNumber', 'phone',\n          'address', 'profilePhotoUri', 'instituteCode', 'role', 'createdAt',\n          'isActive', 'trialEndDate', 'currentPeriodEndMs', 'currentPlanId',\n          'subscriptionStatus', 'studentLimit', 'staffLimit',\n          'studentCount', 'staffCount', 'batchCount'\n        ])\n        && data.role == 'owner'\n        && data.email == request.auth.token.email\n        && data.createdAt is int\n        && data.createdAt >= nowMs - 900000\n        && data.createdAt <= nowMs + 60000\n        && data.trialEndDate is int\n        && data.trialEndDate == data.createdAt + trialDurationMs\n        && data.currentPeriodEndMs is int\n        && data.currentPeriodEndMs == data.trialEndDate\n        && data.currentPlanId == 'plan_free_trial'\n        && data.subscriptionStatus == 'trial'\n        // New clients write 0 for unlimited trial seats. Older supported\n        // clients may still send their former numeric display value; it is\n        // non-authoritative during a live trial and bounded here only as data\n        // validation. Trusted Functions enforce the unlimited entitlement.\n        && data.studentLimit is int\n        && data.studentLimit >= 0\n        && data.studentLimit <= 1000000\n        && data.staffLimit == 1\n        && data.isActive == true\n        && data.studentCount == 0\n        && data.staffCount == 0\n        && data.batchCount == 0;\n    }\n\n    function validSubscriptionRequestCreate() {\n      let data = request.resource.data;\n      let nowMs = request.time.toMillis();\n      return data.keys().hasAll([\n          'instituteId', 'instituteName', 'ownerName', 'institutePhone',\n          'requestedPlanId', 'durationMonths', 'amountPaid', 'transactionLast4',\n          'paymentMethod', 'status', 'requestSentAt', 'reviewedBy',\n          'reviewedAt', 'reviewerNote'\n        ])\n        && data.keys().hasOnly([\n          'instituteId', 'instituteName', 'ownerName', 'institutePhone',\n          'requestedPlanId', 'durationMonths', 'amountPaid', 'transactionLast4',\n          'paymentMethod', 'status', 'requestSentAt', 'reviewedBy',\n          'reviewedAt', 'reviewerNote'\n        ])\n        && data.instituteId == request.auth.uid\n        && data.status == 'pending'\n        && data.reviewedBy == ''\n        && data.reviewedAt == 0\n        && data.reviewerNote == ''\n        && data.requestedPlanId is string\n        && data.requestedPlanId.size() > 0\n        && data.durationMonths is int\n        && data.durationMonths >= 1\n        && data.durationMonths <= 60\n        && data.amountPaid >= 0\n        && data.requestSentAt is int\n        && data.requestSentAt >= nowMs - 900000\n        && data.requestSentAt <= nowMs + 60000;\n    }\n\n    // -----------------------------------------------------------------\n    // Institute root and tenant-owned data\n    // -----------------------------------------------------------------\n\n    match /institutes/{instituteId} {\n      allow get: if (isStudentAuthRequest() && isStudentOf(instituteId))\n        || isPlatformDataReader()\n        || isInstitutePrincipal(instituteId)\n        || isActiveStaff(instituteId);\n      allow list: if isPlatformDataReader();\n\n      allow create: if isSuperAdmin() || validOwnerInstituteCreate(instituteId);\n      allow update: if (isSuperAdmin() && superAdminClientUpdateAvoidsSubscriptionControls())\n        || (isActiveInstitutePrincipal(instituteId)\n          && ownerUpdateTouchesOnlySafeFields()\n          && ownerUpdateHasValidCounters())\n        || (isActiveStaff(instituteId)\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])\n          && request.resource.data.lastActiveAt is int\n          && request.resource.data.lastActiveAt >= 0);\n    }\n\n    // The catch-all grants full operational access only to the institute principal\n    // and SuperAdmin. Staff access is granted collection-by-collection below.\n    match /institutes/{instituteId}/{collection}/{document=**} {\n      allow read, write: if collection != 'students'\n        && collection != 'staffs'\n        && collection != 'fees'\n        && collection != 'payments'\n        && collection != 'receipts'\n        && collection != 'payment_reversals'\n        && collection != 'fee_adjustments'\n        && collection != 'payment_corrections'\n        && collection != 'payment_deletions'\n        && collection != 'financial_operations'\n        && collection != 'ledger_internal'\n        && collection != 'batches'\n        && collection != 'deletion_operations'\n        && collection != 'deletion_states'\n        && collection != 'deletion_audit'\n        && collection != 'media_assets'\n        && collection != 'media_upload_operations'\n        && collection != 'media_audit'\n        && collection != 'subscription_receipts'\n        && collection != 'subscription_audit'\n        && collection != 'subscription_operations'\n        && (isSuperAdmin() || isActiveInstitutePrincipal(instituteId));\n    }\n\n    match /institutes/{instituteId}/staffs/{staffId} {\n      allow read: if (isActiveStaff(instituteId) && request.auth.uid == staffId)\n        || isSuperAdmin()\n        || isActiveInstitutePrincipal(instituteId)\n        || hasStaffPermission(instituteId, 'manage_staff');\n      // Creation is quota-enforced by the trusted callable. Archival is also\n      // server-owned, so a client cannot free a seat without the audit flow.\n      allow create: if false;\n      allow update: if (isSuperAdmin() || isActiveInstitutePrincipal(instituteId))\n        && request.resource.data.archivedAtMs == resource.data.archivedAtMs;\n    }\n\n    match /institutes/{instituteId}/students/{studentId} {\n      // Firestore cannot redact individual fields. A legacy student document that\n      // still contains credential material therefore fails closed for every client\n      // until the Admin SDK migration removes it.\n      allow read: if studentDocumentHasNoCredentialFields(resource.data)\n        && (isStudentRecordOwner(instituteId, studentId)\n          || (!isStudentAuthRequest()\n            && (isSuperAdmin()\n              || isActiveInstitutePrincipal(instituteId)\n              || canReadStudentData(instituteId))));\n      allow create: if false;\n      allow update: if ((isSuperAdmin()\n          || isActiveInstitutePrincipal(instituteId)\n          || hasStaffPermission(instituteId, 'manage_student'))\n          && studentAuthFieldsAreUnchanged()\n          && request.resource.data.archivedAtMs == resource.data.archivedAtMs)\n        || (isStudentRecordOwner(instituteId, studentId)\n          && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly(['phone', 'photoUri', 'address', 'updatedAtMs']));\n    }\n\n    match /institutes/{instituteId}/batches/{batchId} {\n      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))\n        || (!isStudentAuthRequest() && canReadBatchData(instituteId));\n      allow create: if false;\n      allow update: if (isSuperAdmin()\n        || isActiveInstitutePrincipal(instituteId)\n        || hasStaffPermission(instituteId, 'manage_batch'))\n        && request.resource.data.archivedAtMs == resource.data.archivedAtMs;\n    }\n\n    match /institutes/{instituteId}/batch_students/{enrollmentId} {\n      allow read: if isStudentRecordOwner(instituteId, resource.data.studentId)\n        || (!isStudentAuthRequest() && canReadBatchData(instituteId));\n      allow create, update: if isSuperAdmin()\n        || isActiveInstitutePrincipal(instituteId)\n        || hasStaffPermission(instituteId, 'manage_batch');\n    }\n\n    match /institutes/{instituteId}/deletion_operations/{operationId} {\n      allow read: if isSuperAdmin() || isActiveInstitutePrincipal(instituteId);\n    }\n\n    match /institutes/{instituteId}/deletion_states/{stateId} {\n      allow read: if isSuperAdmin() || isActiveInstitutePrincipal(instituteId);\n    }\n\n    match /institutes/{instituteId}/deletion_audit/{auditId} {\n      allow read: if isSuperAdmin() || isActiveInstitutePrincipal(instituteId);\n    }\n\n    // Firebase Storage object paths, ownership, delivery type and upload audit metadata are\n    // backend-only. Clients receive only an opaque reference or a short-lived URL\n    // from App Check + Auth protected callable functions.\n    match /institutes/{instituteId}/media_assets/{assetId} {\n      allow read, write: if false;\n    }\n\n    match /institutes/{instituteId}/media_upload_operations/{operationId} {\n      allow read, write: if false;\n    }\n\n    match /institutes/{instituteId}/media_audit/{auditId} {\n      allow read, write: if false;\n    }\n\n    match /institutes/{instituteId}/fees/{feeId} {\n      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);\n    }\n\n    match /institutes/{instituteId}/payments/{paymentId} {\n      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);\n    }\n\n    match /institutes/{instituteId}/receipts/{receiptId} {\n      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);\n    }\n\n    match /institutes/{instituteId}/payment_reversals/{reversalId} {\n      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);\n    }\n\n    match /institutes/{instituteId}/fee_adjustments/{adjustmentId} {\n      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);\n    }\n\n    // Payment corrections/deletions are backend-only audit records. The visible\n    // payment ledger is updated by the callable Function; clients cannot create\n    // or alter audit records directly.\n    match /institutes/{instituteId}/payment_corrections/{correctionId} {\n      allow read, write: if false;\n    }\n\n    match /institutes/{instituteId}/payment_deletions/{deletionId} {\n      allow read, write: if false;\n    }\n\n    // Subscription receipts use a separate collection from student fee\n    // receipts. Only the trusted server creates them.\n    match /institutes/{instituteId}/subscription_receipts/{receiptId} {\n      allow read: if isPlatformDataReader() || isInstitutePrincipal(instituteId);\n    }\n\n    // These records make subscription mutations reviewable without exposing\n    // operation payloads to tenant users or allowing client-side alteration.\n    match /institutes/{instituteId}/subscription_audit/{auditId} {\n      allow read: if isPlatformDataReader();\n    }\n\n    match /institutes/{instituteId}/subscription_operations/{operationId} {\n      allow read, write: if false;\n    }\n\n    match /institutes/{instituteId}/attendance/{attendanceId} {\n      allow read: if isStudentRecordOwner(instituteId, resource.data.studentId)\n        || (!isStudentAuthRequest() && canReadAttendanceData(instituteId));\n      allow write: if hasStaffPermission(instituteId, 'take_attendance');\n    }\n\n    match /institutes/{instituteId}/absent_messages/{messageId} {\n      allow read: if hasStaffPermission(instituteId, 'send_due_message')\n        || canReadAttendanceData(instituteId);\n      allow write: if hasStaffPermission(instituteId, 'send_due_message');\n    }\n\n    match /institutes/{instituteId}/staff_attendance/{attendanceId} {\n      allow read: if hasStaffPermission(instituteId, 'manage_staff_attendance')\n        || hasStaffPermission(instituteId, 'manage_staff')\n        || hasStaffPermission(instituteId, 'view_reports');\n      allow write: if hasStaffPermission(instituteId, 'manage_staff_attendance')\n        || hasStaffPermission(instituteId, 'manage_staff');\n    }\n\n    match /institutes/{instituteId}/enquiries/{enquiryId} {\n      allow read, write: if hasStaffPermission(instituteId, 'view_reports');\n    }\n\n    match /institutes/{instituteId}/exams/{examId} {\n      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))\n        || (!isStudentAuthRequest()\n          && (hasStaffPermission(instituteId, 'manage_exams')\n            || hasStaffPermission(instituteId, 'view_reports')));\n      allow write: if hasStaffPermission(instituteId, 'manage_exams');\n    }\n\n    match /institutes/{instituteId}/results/{resultId} {\n      allow read: if isStudentRecordOwner(instituteId, resource.data.studentId)\n        || (!isStudentAuthRequest()\n          && (hasStaffPermission(instituteId, 'manage_exams')\n            || hasStaffPermission(instituteId, 'view_reports')));\n      allow write: if hasStaffPermission(instituteId, 'manage_exams');\n    }\n\n    match /institutes/{instituteId}/expenses/{expenseId} {\n      allow read: if hasStaffPermission(instituteId, 'manage_expenses')\n        || hasStaffPermission(instituteId, 'view_reports');\n      allow write: if hasStaffPermission(instituteId, 'manage_expenses');\n    }\n\n    match /institutes/{instituteId}/salaries/{salaryId} {\n      allow read: if hasStaffPermission(instituteId, 'manage_salary')\n        || hasStaffPermission(instituteId, 'view_reports');\n      allow write: if hasStaffPermission(instituteId, 'manage_salary');\n    }\n\n    match /institutes/{instituteId}/reminder_templates/{templateId} {\n      allow read: if hasStaffPermission(instituteId, 'manage_reminders')\n        || hasStaffPermission(instituteId, 'send_due_message');\n      allow write: if hasStaffPermission(instituteId, 'manage_reminders');\n    }\n\n    match /institutes/{instituteId}/audit_logs/{logId} {\n      allow read: if hasStaffPermission(instituteId, 'manage_staff')\n        || hasStaffPermission(instituteId, 'view_reports');\n      allow create: if isActiveStaff(instituteId)\n        && request.resource.data.instituteId == instituteId\n        && request.resource.data.userId == request.auth.uid;\n    }\n\n    match /institutes/{instituteId}/works/{workId} {\n      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))\n        || (!isStudentAuthRequest()\n          && (hasStaffPermission(instituteId, 'view_student')\n            || hasStaffPermission(instituteId, 'manage_student')\n            || hasStaffPermission(instituteId, 'view_batch')\n            || hasStaffPermission(instituteId, 'manage_batch')));\n      allow write: if hasStaffPermission(instituteId, 'manage_student')\n        || hasStaffPermission(instituteId, 'manage_batch');\n    }\n\n    match /institutes/{instituteId}/homework/{homeworkId} {\n      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))\n        || (!isStudentAuthRequest()\n          && (hasStaffPermission(instituteId, 'view_student')\n            || hasStaffPermission(instituteId, 'manage_student')\n            || hasStaffPermission(instituteId, 'view_batch')\n            || hasStaffPermission(instituteId, 'manage_batch')));\n      allow write: if hasStaffPermission(instituteId, 'manage_student')\n        || hasStaffPermission(instituteId, 'manage_batch');\n    }\n\n    match /institutes/{instituteId}/assignments/{assignmentId} {\n      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))\n        || (!isStudentAuthRequest()\n          && (hasStaffPermission(instituteId, 'view_student')\n            || hasStaffPermission(instituteId, 'manage_student')\n            || hasStaffPermission(instituteId, 'view_batch')\n            || hasStaffPermission(instituteId, 'manage_batch')));\n      allow write: if hasStaffPermission(instituteId, 'manage_student')\n        || hasStaffPermission(instituteId, 'manage_batch');\n    }\n\n    match /institutes/{instituteId}/homework_submissions/{submissionId} {\n      allow read, write: if hasStaffPermission(instituteId, 'manage_student')\n        || hasStaffPermission(instituteId, 'manage_batch');\n    }\n\n    match /institutes/{instituteId}/assignment_submissions/{submissionId} {\n      allow read, write: if hasStaffPermission(instituteId, 'manage_student')\n        || hasStaffPermission(instituteId, 'manage_batch');\n    }\n\n    // -----------------------------------------------------------------\n    // Registration and public branding\n    // -----------------------------------------------------------------\n\n    match /registrations/{instituteId}/pending/{requestId} {\n      allow read, delete: if isSuperAdmin()\n        || isActiveInstitutePrincipal(instituteId)\n        || hasStaffPermission(instituteId, 'manage_student');\n      // Public registrations are written only by the rate-limited Cloud\n      // Function. Client-side writes would make abuse prevention bypassable.\n      allow create: if false;\n    }\n\n    match /registrations/{instituteId}/{collection}/{document=**} {\n      allow read, write: if isSuperAdmin()\n        || isActiveInstitutePrincipal(instituteId)\n        || hasStaffPermission(instituteId, 'manage_student');\n    }\n\n    match /registrations/{instituteId} {\n      allow read, write: if isSuperAdmin() || isActiveInstitutePrincipal(instituteId);\n    }\n\n    match /public_registration_profiles/{profileId} {\n      allow get: if true;\n      allow create: if isSignedIn()\n        && validPublicRegistrationProfile()\n        && (request.auth.uid == request.resource.data.instituteId || isSuperAdmin());\n      allow update: if isSignedIn()\n        && validPublicRegistrationProfile()\n        && request.resource.data.instituteId == resource.data.instituteId\n        && (request.auth.uid == resource.data.instituteId || isSuperAdmin());\n      allow delete: if isSignedIn()\n        && (request.auth.uid == resource.data.instituteId || isSuperAdmin());\n    }\n\n    // -----------------------------------------------------------------\n    // Global and privileged collections\n    // -----------------------------------------------------------------\n\n    match /Global_Notifications/{document=**} {\n      allow read: if isSignedIn();\n      allow write: if isSuperAdmin();\n    }\n\n    match /app_users/{userId} {\n      allow read: if isPlatformDataReader()\n        || (isSignedIn()\n          && request.auth.uid == userId\n          && (!('status' in resource.data) || resource.data.status == 'active'));\n      // Account creation, ownership, status, tenant assignment and platform\n      // role changes are Admin-SDK-only through commitPlatformAdminOperation.\n      // This prevents even a compromised Root client from forging authority.\n      allow create: if false;\n      allow update: if isSuperAdmin()\n        && request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['name', 'email']);\n    }\n\n    match /subscriptionRequests/{requestId} {\n      allow read: if isPlatformDataReader()\n        || (isSignedIn() && exists(institutePath(resource.data.instituteId))\n          && (isOwner(resource.data.instituteId) || isManagedInstituteOwner(resource.data.instituteId)));\n      // Payment request creation/review is server-authoritative so the owner\n      // cannot choose a price, plan snapshot, reviewer state, or duplicate key.\n      allow create, update, delete: if false;\n    }\n\n    match /subscription_plans/{planId} {\n      allow read: if isSignedIn();\n      allow write: if isSuperAdmin();\n    }\n\n    // Cloud Functions write every platform operation and audit record.  These\n    // are readable for accountable support work but cannot be forged or erased\n    // by any client role, including Root.\n    match /platform_audit/{auditId} {\n      allow read: if isPlatformDataReader();\n      allow write: if false;\n    }\n\n    match /platform_admin_operations/{operationId} {\n      allow read, write: if false;\n    }\n\n    // Force-update metadata contains no tenant-private data and is needed before login.\n    match /Config/{documentId} {\n      allow get: if true;\n      allow write: if isSuperAdmin();\n    }\n\n    // Existing demo telemetry behaviour is intentionally unchanged in this scoped fix.\n    match /Demo_Visitors/{document=**} {\n      allow read, write: if true;\n    }\n\n    match /institutes_trash/{document=**} {\n      allow read: if isSuperAdmin();\n    }\n\n    match /app_users_trash/{document=**} {\n      allow read: if isSuperAdmin();\n    }\n\n    // Legacy mappings and the replacement password/UID indexes are backend-only.\n    match /student_login_mappings/{studentCode} {\n      allow read, write: if false;\n    }\n\n    match /student_auth_logins/{documentId} {\n      allow read, write: if false;\n    }\n\n    match /student_auth_accounts/{documentId} {\n      allow read, write: if false;\n    }\n\n    match /student_auth_attempts/{documentId} {\n      allow read, write: if false;\n    }\n\n    // Fail closed. Every readable/writable collection must be explicitly declared above.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-14T09:53:22.189583Z","metadata":{"services":["cloud.firestore"]}}
