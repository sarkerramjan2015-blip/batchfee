rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Web form registrations — public create, authenticated read/manage
    match /registrations/{instituteId}/pending/{requestId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow delete: if request.auth != null;
    }
    match /registrations/{instituteId} {
      allow read, write: if request.auth != null;
    }

    // Institutes — public read (web form header), authenticated write
    match /institutes/{document=**} {
      allow read: if true;
      allow write, update, delete: if request.auth != null;
    }

    // Global notifications — authenticated users can read/write
    match /Global_Notifications/{document=**} {
      allow read, write: if request.auth != null;
    }

    // SuperAdmin stats — authenticated read/write
    match /SuperAdmin/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Demo visitor tracking — open
    match /Demo_Visitors/{document=**} {
      allow read, write: if true;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
