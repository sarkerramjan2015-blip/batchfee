rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Identity and tenant helpers
    // -----------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function institutePath(instituteId) {
      return /databases/$(database)/documents/institutes/$(instituteId);
    }

    function staffPath(instituteId) {
      return /databases/$(database)/documents/institutes/$(instituteId)/staffs/$(request.auth.uid);
    }

    function studentPath(instituteId, studentId) {
      return /databases/$(database)/documents/institutes/$(instituteId)/students/$(studentId);
    }

    function managedUserPath() {
      return /databases/$(database)/documents/app_users/$(request.auth.uid);
    }

    // Privileged roles are trusted only from app_users. Institute documents are
    // owner-editable profile records and must never be a source of global authority.
    function isSuperAdmin() {
      let path = managedUserPath();
      return isSignedIn()
        && exists(path)
        && (get(path).data.role in ['SuperAdmin', 'superAdmin', 'super_admin']
          || get(path).data.platformRole == 'root')
        && (!('status' in get(path).data) || get(path).data.status == 'active');
    }

    // Non-root platform roles may inspect the operational directory and its
    // immutable audit trail. They never receive a client-side mutation path.
    function isPlatformDataReader() {
      let path = managedUserPath();
      return isSignedIn()
        && exists(path)
        && (get(path).data.role in ['SuperAdmin', 'superAdmin', 'super_admin']
          || get(path).data.platformRole in ['root', 'billing', 'support', 'operations', 'read_only'])
        && (!('status' in get(path).data) || get(path).data.status == 'active');
    }

    function isOwner(instituteId) {
      let path = institutePath(instituteId);
      return isSignedIn()
        && ((!exists(path) && request.auth.uid == instituteId)
          || (exists(path)
            && (('ownerUid' in get(path).data && get(path).data.ownerUid == request.auth.uid)
              || (!('ownerUid' in get(path).data) && request.auth.uid == instituteId))));
    }

    function isManagedInstituteOwner(instituteId) {
      let path = managedUserPath();
      return isSignedIn()
        && exists(path)
        && get(path).data.instituteId == instituteId
        && get(path).data.role in ['InstituteOwner', 'owner', 'instituteOwner', 'institute_owner']
        && (!('status' in get(path).data) || get(path).data.status == 'active');
    }

    function isManagedInstituteAdmin(instituteId) {
      let path = managedUserPath();
      return isSignedIn()
        && exists(path)
        && get(path).data.instituteId == instituteId
        && get(path).data.role in ['InstituteAdmin', 'admin', 'instituteAdmin', 'institute_admin']
        && (!('status' in get(path).data) || get(path).data.status == 'active');
    }

    function isInstitutePrincipal(instituteId) {
      return isInstituteEnabledForStaff(instituteId)
        && (isOwner(instituteId) || isManagedInstituteOwner(instituteId)
          || isManagedInstituteAdmin(instituteId));
    }

    function isInstituteEnabledForStaff(instituteId) {
      let path = institutePath(instituteId);
      return exists(path)
        && (!('isActive' in get(path).data) || get(path).data.isActive == true);
    }

    // The period end is the source of truth for entitlement. A scheduled
    // backend task updates the display status after this rule has already
    // stopped operational access.
    function hasActiveSubscription(instituteId) {
      let path = institutePath(instituteId);
      return exists(path)
        && get(path).data.isActive == true
        && get(path).data.currentPeriodEndMs is int
        && get(path).data.currentPeriodEndMs > request.time.toMillis()
        && get(path).data.subscriptionStatus in ['trial', 'active'];
    }

    function isActiveInstitutePrincipal(instituteId) {
      return isInstitutePrincipal(instituteId) && hasActiveSubscription(instituteId);
    }

    // A staff account is authorised only while both the institute and staff
    // records are active. Missing, inactive, blocked, or archived records fail closed.
    function isActiveStaff(instituteId) {
      let path = staffPath(instituteId);
      return isSignedIn()
        && hasActiveSubscription(instituteId)
        && exists(path)
        && get(path).data.status == 'active'
        && (!('archivedAtMs' in get(path).data) || get(path).data.archivedAtMs == null);
    }

    // Staff permissions are currently stored as a normalized comma-separated
    // string. Match complete tokens so similarly named permissions cannot collide.
    function hasStaffPermission(instituteId, permission) {
      let path = staffPath(instituteId);
      return isActiveStaff(instituteId)
        && get(path).data.permissions is string
        && get(path).data.permissions.matches('(^|.*,)' + permission + '(,.*|$)');
    }

    function hasActiveStudentToken() {
      return isSignedIn()
        && request.auth.token.keys().hasAll([
          'student', 'studentId', 'instituteId', 'studentSessionExpiresAt'
        ])
        && request.auth.token.student == true
        && request.auth.token.studentId is string
        && request.auth.token.instituteId is string
        && request.auth.token.studentSessionExpiresAt is int
        && request.auth.token.studentSessionExpiresAt > request.time.toMillis();
    }

    function isStudentAuthRequest() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['student'])
        && request.auth.token.student == true;
    }

    // Student authority needs all three bindings: short-lived server claims, the
    // claimed institute, and a live student document linked to the Firebase UID.
    function isStudentOf(instituteId) {
      let path = studentPath(instituteId, request.auth.token.studentId);
      return hasActiveStudentToken()
        && request.auth.token.instituteId == instituteId
        && hasActiveSubscription(instituteId)
        && exists(path)
        && get(path).data.firebaseUid == request.auth.uid
        && get(path).data.isAppAccessEnabled == true
        && get(path).data.status == 'active'
        && (!('archivedAtMs' in get(path).data) || get(path).data.archivedAtMs == null);
    }

    function isStudentRecordOwner(instituteId, studentId) {
      return isStudentOf(instituteId) && request.auth.token.studentId == studentId;
    }

    function studentCredentialFields() {
      return [
        'studentPasswordHash',
        'appAccessEmail',
        'appAccessPassword',
        'passwordHash',
        'passwordSalt',
        'passwordVerifier',
        'virtualEmail',
        'authEmail'
      ];
    }

    function studentDocumentHasNoCredentialFields(data) {
      return !data.keys().hasAny(studentCredentialFields());
    }

    // This is the complete document schema exposed to an unauthenticated
    // registration visitor. Keep private institute fields out of this separate
    // collection; Firestore rules cannot redact individual fields on a read.
    function validPublicRegistrationProfile() {
      return request.resource.data.keys().hasOnly([
          'instituteId', 'instituteName', 'slug', 'phone', 'profilePhotoUri', 'updatedAtMs'
        ])
        && request.resource.data.instituteId is string
        && request.resource.data.instituteId.size() > 0
        && request.resource.data.instituteId.size() <= 128
        && request.resource.data.instituteName is string
        && request.resource.data.instituteName.size() > 0
        && request.resource.data.instituteName.size() <= 120
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 80
        && (!('phone' in request.resource.data)
          || request.resource.data.phone == null
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))
        && (!('profilePhotoUri' in request.resource.data)
          || request.resource.data.profilePhotoUri == null
          || (request.resource.data.profilePhotoUri is string
            && request.resource.data.profilePhotoUri.size() <= 2048))
        && request.resource.data.updatedAtMs is int;
    }

    // Android publishes the same safe public profile under its readable slug
    // and under an institute-id alias used by older shared links. Binding the
    // document id to one of those two values keeps writes scoped without
    // rejecting valid Bengali (or other Unicode) institute names.
    function publicRegistrationProfileIdMatches(profileId) {
      return profileId == request.resource.data.slug
        || profileId == 'id_' + request.resource.data.instituteId;
    }

    function studentCreateHasNoAuthFields() {
      return studentDocumentHasNoCredentialFields(request.resource.data)
        && !request.resource.data.keys().hasAny([
          'firebaseUid', 'isAppAccessEnabled'
        ]);
    }

    function studentAuthFieldsAreUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'firebaseUid',
          'isAppAccessEnabled',
          'studentPasswordHash',
          'appAccessEmail',
          'appAccessPassword',
          'passwordHash',
          'passwordSalt',
          'passwordVerifier',
          'virtualEmail',
          'authEmail'
        ])
        && studentDocumentHasNoCredentialFields(resource.data)
        && studentDocumentHasNoCredentialFields(request.resource.data);
    }

    function canReadStudentData(instituteId) {
      return hasStaffPermission(instituteId, 'view_student')
        || hasStaffPermission(instituteId, 'manage_student')
        || hasStaffPermission(instituteId, 'view_batch')
        || hasStaffPermission(instituteId, 'manage_batch')
        || hasStaffPermission(instituteId, 'view_fee_summary')
        || hasStaffPermission(instituteId, 'collect_fee')
        || hasStaffPermission(instituteId, 'send_due_message')
        || hasStaffPermission(instituteId, 'take_attendance')
        || hasStaffPermission(instituteId, 'view_attendance_reports')
        || hasStaffPermission(instituteId, 'view_reports')
        || hasStaffPermission(instituteId, 'manage_exams')
        || hasStaffPermission(instituteId, 'generate_id_cards')
        || hasStaffPermission(instituteId, 'birthday_reminders');
    }

    function canReadBatchData(instituteId) {
      return hasStaffPermission(instituteId, 'view_batch')
        || hasStaffPermission(instituteId, 'manage_batch')
        || hasStaffPermission(instituteId, 'view_student')
        || hasStaffPermission(instituteId, 'manage_student')
        || hasStaffPermission(instituteId, 'view_fee_summary')
        || hasStaffPermission(instituteId, 'collect_fee')
        || hasStaffPermission(instituteId, 'take_attendance')
        || hasStaffPermission(instituteId, 'view_attendance_reports')
        || hasStaffPermission(instituteId, 'view_reports')
        || hasStaffPermission(instituteId, 'manage_exams');
    }

    function canReadFinanceData(instituteId) {
      return hasStaffPermission(instituteId, 'view_fee_summary')
        || hasStaffPermission(instituteId, 'collect_fee')
        || hasStaffPermission(instituteId, 'send_due_message')
        || hasStaffPermission(instituteId, 'view_reports');
    }

    function canReadFinancialRecord(instituteId, studentId) {
      return isStudentRecordOwner(instituteId, studentId)
        || (!isStudentAuthRequest()
          && (isSuperAdmin()
            || isActiveInstitutePrincipal(instituteId)
            || canReadFinanceData(instituteId)));
    }

    function canReadAttendanceData(instituteId) {
      return hasStaffPermission(instituteId, 'take_attendance')
        || hasStaffPermission(instituteId, 'view_attendance_reports')
        || hasStaffPermission(instituteId, 'view_reports');
    }

    function ownerUpdateTouchesOnlySafeFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'instituteName',
        'name',
        'ownerName',
        'email',
        'phone',
        'address',
        'whatsappNumber',
        'profilePhotoUri',
        'instituteCode',
        'lastActiveAt'
      ]);
    }

    function ownerUpdateHasValidCounters() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['studentCount'])
          || (request.resource.data.studentCount is int && request.resource.data.studentCount >= 0))
        && (!changed.hasAny(['staffCount'])
          || (request.resource.data.staffCount is int && request.resource.data.staffCount >= 0))
        && (!changed.hasAny(['batchCount'])
          || (request.resource.data.batchCount is int && request.resource.data.batchCount >= 0))
        && (!changed.hasAny(['lastActiveAt'])
          || (request.resource.data.lastActiveAt is int && request.resource.data.lastActiveAt >= 0));
    }

    // Subscription entitlement, access state, and limits are modified only by
    // the App Check-protected subscription callable. A Super Admin may still
    // edit normal institute profile fields directly, but cannot bypass the
    // server-side quote, renewal, duplicate-payment, and audit controls.
    function superAdminClientUpdateAvoidsSubscriptionControls() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'trialEndDate',
        'currentPeriodEndMs',
        'subscriptionStatus',
        'preBlockSubscriptionStatus',
        'isActive',
        'studentLimit',
        'staffLimit',
        'currentPlanId',
        'subscriptionExpiredAtMs',
        'studentCount',
        'staffCount',
        'batchCount',
        'countSummaryUpdatedAtMs'
      ]);
    }

    function validOwnerInstituteCreate(instituteId) {
      let data = request.resource.data;
      let nowMs = request.time.toMillis();
      let trialDurationMs = 2592000000;
      return isOwner(instituteId)
        && data.keys().hasAll([
          'instituteName', 'ownerName', 'email', 'role', 'createdAt',
          'isActive', 'trialEndDate', 'currentPeriodEndMs', 'currentPlanId',
          'subscriptionStatus', 'studentLimit', 'staffLimit',
          'studentCount', 'staffCount', 'batchCount'
        ])
        && data.keys().hasOnly([
          'instituteName', 'ownerName', 'email', 'whatsappNumber', 'phone',
          'address', 'profilePhotoUri', 'instituteCode', 'role', 'createdAt',
          'isActive', 'trialEndDate', 'currentPeriodEndMs', 'currentPlanId',
          'subscriptionStatus', 'studentLimit', 'staffLimit',
          'studentCount', 'staffCount', 'batchCount'
        ])
        && data.role == 'owner'
        // Firebase Auth may take a moment to refresh optional token claims
        // immediately after an account is created. The UID/document binding is
        // the ownership check; email remains validated profile data.
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.createdAt is int
        && data.createdAt >= nowMs - 900000
        && data.createdAt <= nowMs + 60000
        && data.trialEndDate is int
        && data.trialEndDate == data.createdAt + trialDurationMs
        && data.currentPeriodEndMs is int
        && data.currentPeriodEndMs == data.trialEndDate
        && data.currentPlanId == 'plan_free_trial'
        && data.subscriptionStatus == 'trial'
        // New clients write 0 for unlimited trial seats. Older supported
        // clients may still send their former numeric display value; it is
        // non-authoritative during a live trial and bounded here only as data
        // validation. Trusted Functions enforce the unlimited entitlement.
        && data.studentLimit is int
        && data.studentLimit >= 0
        && data.studentLimit <= 1000000
        && data.staffLimit == 1
        && data.isActive == true
        && data.studentCount == 0
        && data.staffCount == 0
        && data.batchCount == 0;
    }

    function validSubscriptionRequestCreate() {
      let data = request.resource.data;
      let nowMs = request.time.toMillis();
      return data.keys().hasAll([
          'instituteId', 'instituteName', 'ownerName', 'institutePhone',
          'requestedPlanId', 'durationMonths', 'amountPaid', 'transactionLast4',
          'paymentMethod', 'status', 'requestSentAt', 'reviewedBy',
          'reviewedAt', 'reviewerNote'
        ])
        && data.keys().hasOnly([
          'instituteId', 'instituteName', 'ownerName', 'institutePhone',
          'requestedPlanId', 'durationMonths', 'amountPaid', 'transactionLast4',
          'paymentMethod', 'status', 'requestSentAt', 'reviewedBy',
          'reviewedAt', 'reviewerNote'
        ])
        && data.instituteId == request.auth.uid
        && data.status == 'pending'
        && data.reviewedBy == ''
        && data.reviewedAt == 0
        && data.reviewerNote == ''
        && data.requestedPlanId is string
        && data.requestedPlanId.size() > 0
        && data.durationMonths is int
        && data.durationMonths >= 1
        && data.durationMonths <= 60
        && data.amountPaid >= 0
        && data.requestSentAt is int
        && data.requestSentAt >= nowMs - 900000
        && data.requestSentAt <= nowMs + 60000;
    }

    // -----------------------------------------------------------------
    // Institute root and tenant-owned data
    // -----------------------------------------------------------------

    match /institutes/{instituteId} {
      allow get: if (isStudentAuthRequest() && isStudentOf(instituteId))
        || isPlatformDataReader()
        || isInstitutePrincipal(instituteId)
        || isActiveStaff(instituteId);
      allow list: if isPlatformDataReader();

      allow create: if isSuperAdmin() || validOwnerInstituteCreate(instituteId);
      allow update: if (isSuperAdmin() && superAdminClientUpdateAvoidsSubscriptionControls())
        || (isActiveInstitutePrincipal(instituteId)
          && ownerUpdateTouchesOnlySafeFields()
          && ownerUpdateHasValidCounters())
        || (isActiveStaff(instituteId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
          && request.resource.data.lastActiveAt is int
          && request.resource.data.lastActiveAt >= 0);
    }

    // The catch-all grants full operational access only to the institute principal
    // and SuperAdmin. Staff access is granted collection-by-collection below.
    match /institutes/{instituteId}/{collection}/{document=**} {
      allow read, write: if collection != 'students'
        && collection != 'staffs'
        && collection != 'fees'
        && collection != 'payments'
        && collection != 'receipts'
        && collection != 'payment_reversals'
        && collection != 'fee_adjustments'
        && collection != 'payment_corrections'
        && collection != 'payment_deletions'
        && collection != 'financial_operations'
        && collection != 'ledger_internal'
        && collection != 'batches'
        && collection != 'deletion_operations'
        && collection != 'deletion_states'
        && collection != 'deletion_audit'
        && collection != 'media_assets'
        && collection != 'media_upload_operations'
        && collection != 'media_audit'
        && collection != 'dashboard_summary'
        && collection != 'creation_operations'
        && collection != 'subscription_receipts'
        && collection != 'subscription_audit'
        && collection != 'subscription_operations'
        && (isSuperAdmin() || isActiveInstitutePrincipal(instituteId));
    }

    match /institutes/{instituteId}/staffs/{staffId} {
      allow read: if (isActiveStaff(instituteId) && request.auth.uid == staffId)
        || isSuperAdmin()
        || isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_staff');
      // Creation is quota-enforced by the trusted callable. Archival is also
      // server-owned, so a client cannot free a seat without the audit flow.
      allow create: if false;
      allow update: if (isSuperAdmin() || isActiveInstitutePrincipal(instituteId))
        && request.resource.data.archivedAtMs == resource.data.archivedAtMs;
    }

    match /institutes/{instituteId}/students/{studentId} {
      // Firestore cannot redact individual fields. A legacy student document that
      // still contains credential material therefore fails closed for every client
      // until the Admin SDK migration removes it.
      allow read: if studentDocumentHasNoCredentialFields(resource.data)
        && (isStudentRecordOwner(instituteId, studentId)
          || (!isStudentAuthRequest()
            && (isSuperAdmin()
              || isActiveInstitutePrincipal(instituteId)
              || canReadStudentData(instituteId))));
      allow create: if false;
      allow update: if ((isSuperAdmin()
          || isActiveInstitutePrincipal(instituteId)
          || hasStaffPermission(instituteId, 'manage_student'))
          && studentAuthFieldsAreUnchanged()
          && request.resource.data.archivedAtMs == resource.data.archivedAtMs)
        || (isStudentRecordOwner(instituteId, studentId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['phone', 'photoUri', 'address', 'updatedAtMs']));
    }

    match /institutes/{instituteId}/batches/{batchId} {
      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))
        || (!isStudentAuthRequest()
          && (isActiveInstitutePrincipal(instituteId) || canReadBatchData(instituteId)));
      allow create: if false;
      allow update: if (isSuperAdmin()
        || isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_batch'))
        && request.resource.data.archivedAtMs == resource.data.archivedAtMs;
    }

    match /institutes/{instituteId}/batch_students/{enrollmentId} {
      allow read: if isStudentRecordOwner(instituteId, resource.data.studentId)
        || (!isStudentAuthRequest()
          && (isActiveInstitutePrincipal(instituteId) || canReadBatchData(instituteId)));
      allow create, update: if isSuperAdmin()
        || isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_batch');
    }

    match /institutes/{instituteId}/deletion_operations/{operationId} {
      allow read: if isSuperAdmin() || isActiveInstitutePrincipal(instituteId);
    }

    match /institutes/{instituteId}/deletion_states/{stateId} {
      allow read: if isSuperAdmin() || isActiveInstitutePrincipal(instituteId);
    }

    match /institutes/{instituteId}/deletion_audit/{auditId} {
      allow read: if isSuperAdmin() || isActiveInstitutePrincipal(instituteId);
    }

    // Operational counts are recomputed by trusted Firestore triggers. Clients
    // can display the summary but cannot forge usage or subscription counters.
    match /institutes/{instituteId}/dashboard_summary/{summaryId} {
      allow read: if isSuperAdmin()
        || isActiveInstitutePrincipal(instituteId)
        || isActiveStaff(instituteId);
      allow write: if false;
    }

    match /institutes/{instituteId}/creation_operations/{operationId} {
      allow read, write: if false;
    }

    // Firebase Storage object paths, ownership, delivery type and upload audit metadata are
    // backend-only. Clients receive only an opaque reference or a short-lived URL
    // from App Check + Auth protected callable functions.
    match /institutes/{instituteId}/media_assets/{assetId} {
      allow read, write: if false;
    }

    match /institutes/{instituteId}/media_upload_operations/{operationId} {
      allow read, write: if false;
    }

    match /institutes/{instituteId}/media_audit/{auditId} {
      allow read, write: if false;
    }

    match /institutes/{instituteId}/fees/{feeId} {
      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);
    }

    match /institutes/{instituteId}/payments/{paymentId} {
      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);
    }

    match /institutes/{instituteId}/receipts/{receiptId} {
      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);
      // A new owner may write only the zero-value receipt for their own
      // automatically-created free trial. Paid receipt writes stay server-only.
      allow create: if isActiveInstitutePrincipal(instituteId)
        && get(institutePath(instituteId)).data.currentPlanId == 'plan_free_trial'
        && get(institutePath(instituteId)).data.subscriptionStatus == 'trial'
        && request.resource.data.keys().hasOnly([
          'receiptNumber', 'instituteId', 'instituteName', 'ownerName', 'ownerEmail',
          'ownerPhone', 'instituteCode', 'instituteAddress', 'planId', 'planName',
          'durationMonths', 'amountPaid', 'paymentMethod', 'transactionLast4',
          'startDateMs', 'endDateMs', 'approvedAt', 'status'
        ])
        && request.resource.data.receiptNumber == receiptId
        && request.resource.data.receiptNumber is string
        && request.resource.data.receiptNumber.matches('^TRIAL-[0-9]+$')
        && request.resource.data.instituteId == instituteId
        && request.resource.data.instituteName == get(institutePath(instituteId)).data.instituteName
        && request.resource.data.ownerName == get(institutePath(instituteId)).data.ownerName
        && request.resource.data.ownerEmail == get(institutePath(instituteId)).data.email
        // Older supported clients wrote an empty phone on the zero-value trial
        // receipt. Current clients copy the verified institute contact. Accept
        // both shapes, but never allow an unrelated phone to be attached.
        && (request.resource.data.ownerPhone == ''
          || (('phone' in get(institutePath(instituteId)).data)
            && request.resource.data.ownerPhone == get(institutePath(instituteId)).data.phone)
          || (('whatsappNumber' in get(institutePath(instituteId)).data)
            && request.resource.data.ownerPhone == get(institutePath(instituteId)).data.whatsappNumber))
        && request.resource.data.instituteCode == ''
        && request.resource.data.instituteAddress == ''
        && request.resource.data.planId == 'plan_free_trial'
        && request.resource.data.planName == 'Free Trial'
        && request.resource.data.durationMonths == 1
        && request.resource.data.amountPaid == 0
        && request.resource.data.paymentMethod == 'free_trial'
        && request.resource.data.transactionLast4 == ''
        && request.resource.data.startDateMs == get(institutePath(instituteId)).data.createdAt
        && request.resource.data.endDateMs == get(institutePath(instituteId)).data.currentPeriodEndMs
        && request.resource.data.approvedAt == get(institutePath(instituteId)).data.createdAt
        && request.resource.data.status == 'approved';
    }

    match /institutes/{instituteId}/payment_reversals/{reversalId} {
      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);
    }

    match /institutes/{instituteId}/fee_adjustments/{adjustmentId} {
      allow read: if canReadFinancialRecord(instituteId, resource.data.studentId);
    }

    // Payment corrections/deletions are backend-only audit records. The visible
    // payment ledger is updated by the callable Function; clients cannot create
    // or alter audit records directly.
    match /institutes/{instituteId}/payment_corrections/{correctionId} {
      allow read, write: if false;
    }

    match /institutes/{instituteId}/payment_deletions/{deletionId} {
      allow read, write: if false;
    }

    // Subscription receipts use a separate collection from student fee
    // receipts. Only the trusted server creates them.
    match /institutes/{instituteId}/subscription_receipts/{receiptId} {
      allow read: if isPlatformDataReader() || isInstitutePrincipal(instituteId);
    }

    // Super Admin loads the canonical receipt ledger across every institute
    // with a collection-group query. Keep that global view platform-only;
    // tenant users continue to use the scoped rule above for their own records.
    match /{path=**}/subscription_receipts/{receiptId} {
      allow read: if isPlatformDataReader();
    }

    // These records make subscription mutations reviewable without exposing
    // operation payloads to tenant users or allowing client-side alteration.
    match /institutes/{instituteId}/subscription_audit/{auditId} {
      allow read: if isPlatformDataReader();
    }

    match /institutes/{instituteId}/subscription_operations/{operationId} {
      allow read, write: if false;
    }

    match /institutes/{instituteId}/attendance/{attendanceId} {
      allow read: if isStudentRecordOwner(instituteId, resource.data.studentId)
        || (!isStudentAuthRequest() && canReadAttendanceData(instituteId));
      allow write: if hasStaffPermission(instituteId, 'take_attendance');
    }

    match /institutes/{instituteId}/absent_messages/{messageId} {
      allow read: if hasStaffPermission(instituteId, 'send_due_message')
        || canReadAttendanceData(instituteId);
      allow write: if hasStaffPermission(instituteId, 'send_due_message');
    }

    match /institutes/{instituteId}/staff_attendance/{attendanceId} {
      allow read: if hasStaffPermission(instituteId, 'manage_staff_attendance')
        || hasStaffPermission(instituteId, 'manage_staff')
        || hasStaffPermission(instituteId, 'view_reports');
      allow write: if hasStaffPermission(instituteId, 'manage_staff_attendance')
        || hasStaffPermission(instituteId, 'manage_staff');
    }

    match /institutes/{instituteId}/enquiries/{enquiryId} {
      allow read, write: if isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'view_reports');
    }

    match /institutes/{instituteId}/exams/{examId} {
      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))
        || (!isStudentAuthRequest()
          && (hasStaffPermission(instituteId, 'manage_exams')
            || hasStaffPermission(instituteId, 'view_reports')));
      allow write: if hasStaffPermission(instituteId, 'manage_exams');
    }

    match /institutes/{instituteId}/results/{resultId} {
      allow read: if isStudentRecordOwner(instituteId, resource.data.studentId)
        || (!isStudentAuthRequest()
          && (hasStaffPermission(instituteId, 'manage_exams')
            || hasStaffPermission(instituteId, 'view_reports')));
      allow write: if hasStaffPermission(instituteId, 'manage_exams');
    }

    match /institutes/{instituteId}/expenses/{expenseId} {
      allow read: if hasStaffPermission(instituteId, 'manage_expenses')
        || hasStaffPermission(instituteId, 'view_reports');
      allow write: if hasStaffPermission(instituteId, 'manage_expenses');
    }

    match /institutes/{instituteId}/salaries/{salaryId} {
      allow read: if hasStaffPermission(instituteId, 'manage_salary')
        || hasStaffPermission(instituteId, 'view_reports');
      allow write: if hasStaffPermission(instituteId, 'manage_salary');
    }

    match /institutes/{instituteId}/reminder_templates/{templateId} {
      allow read: if hasStaffPermission(instituteId, 'manage_reminders')
        || hasStaffPermission(instituteId, 'send_due_message');
      allow write: if hasStaffPermission(instituteId, 'manage_reminders');
    }

    match /institutes/{instituteId}/audit_logs/{logId} {
      allow read: if hasStaffPermission(instituteId, 'manage_staff')
        || hasStaffPermission(instituteId, 'view_reports');
      allow create: if isActiveStaff(instituteId)
        && request.resource.data.instituteId == instituteId
        && request.resource.data.userId == request.auth.uid;
    }

    // Student app activity is written only by a trusted Callable Function after
    // verifying the short-lived student token. Owners have a realtime,
    // read-only view; students and staff cannot forge or alter it.
    match /institutes/{instituteId}/student_activity/{activityId} {
      allow read: if !isStudentAuthRequest() && isActiveInstitutePrincipal(instituteId);
      allow write: if false;
    }

    match /institutes/{instituteId}/student_activity_presence/{studentId} {
      allow read: if !isStudentAuthRequest() && isActiveInstitutePrincipal(instituteId);
      allow write: if false;
    }

    match /institutes/{instituteId}/works/{workId} {
      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))
        || (!isStudentAuthRequest()
          && (isActiveInstitutePrincipal(instituteId)
            || hasStaffPermission(instituteId, 'view_student')
            || hasStaffPermission(instituteId, 'manage_student')
            || hasStaffPermission(instituteId, 'view_batch')
            || hasStaffPermission(instituteId, 'manage_batch')));
      allow write: if isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_student')
        || hasStaffPermission(instituteId, 'manage_batch');
    }

    match /institutes/{instituteId}/homework/{homeworkId} {
      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))
        || (!isStudentAuthRequest()
          && (isActiveInstitutePrincipal(instituteId)
            || hasStaffPermission(instituteId, 'view_student')
            || hasStaffPermission(instituteId, 'manage_student')
            || hasStaffPermission(instituteId, 'view_batch')
            || hasStaffPermission(instituteId, 'manage_batch')));
      allow write: if isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_student')
        || hasStaffPermission(instituteId, 'manage_batch');
    }

    match /institutes/{instituteId}/assignments/{assignmentId} {
      allow read: if (isStudentAuthRequest() && isStudentOf(instituteId))
        || (!isStudentAuthRequest()
          && (isActiveInstitutePrincipal(instituteId)
            || hasStaffPermission(instituteId, 'view_student')
            || hasStaffPermission(instituteId, 'manage_student')
            || hasStaffPermission(instituteId, 'view_batch')
            || hasStaffPermission(instituteId, 'manage_batch')));
      allow write: if isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_student')
        || hasStaffPermission(instituteId, 'manage_batch');
    }

    match /institutes/{instituteId}/homework_submissions/{submissionId} {
      allow read, write: if isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_student')
        || hasStaffPermission(instituteId, 'manage_batch');
    }

    match /institutes/{instituteId}/assignment_submissions/{submissionId} {
      allow read, write: if isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_student')
        || hasStaffPermission(instituteId, 'manage_batch');
    }

    // -----------------------------------------------------------------
    // Registration and public branding
    // -----------------------------------------------------------------

    match /registrations/{instituteId}/pending/{requestId} {
      allow read, delete: if isSuperAdmin()
        || isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_student');
      // Public registrations are written only by the rate-limited Cloud
      // Function. Client-side writes would make abuse prevention bypassable.
      allow create: if false;
    }

    // These server-owned markers make approving a public registration idempotent.
    // A second request with the same ID cannot create another student record.
    match /registrations/{instituteId}/approval_operations/{requestId} {
      allow read: if isSuperAdmin()
        || isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_student');
      allow write: if false;
    }

    match /registrations/{instituteId}/{collection}/{document=**} {
      allow read, write: if collection != 'approval_operations'
        && (isSuperAdmin()
        || isActiveInstitutePrincipal(instituteId)
        || hasStaffPermission(instituteId, 'manage_student'));
    }

    match /registrations/{instituteId} {
      allow read, write: if isSuperAdmin() || isActiveInstitutePrincipal(instituteId);
    }

    match /public_registration_profiles/{profileId} {
      allow get: if true;
      allow create: if isSignedIn()
        && validPublicRegistrationProfile()
        && publicRegistrationProfileIdMatches(profileId)
        && (isInstitutePrincipal(request.resource.data.instituteId) || isSuperAdmin());
      allow update: if isSignedIn()
        && validPublicRegistrationProfile()
        && publicRegistrationProfileIdMatches(profileId)
        && request.resource.data.instituteId == resource.data.instituteId
        && (isInstitutePrincipal(resource.data.instituteId) || isSuperAdmin());
      allow delete: if isSignedIn()
        && (isInstitutePrincipal(resource.data.instituteId) || isSuperAdmin());
    }

    // -----------------------------------------------------------------
    // Global and privileged collections
    // -----------------------------------------------------------------

    match /Global_Notifications/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /app_users/{userId} {
      allow read: if isPlatformDataReader()
        || (isSignedIn()
          && request.auth.uid == userId
          && (!('status' in resource.data) || resource.data.status == 'active'));
      // Account creation, ownership, status, tenant assignment and platform
      // role changes are Admin-SDK-only through commitPlatformAdminOperation.
      // This prevents even a compromised Root client from forging authority.
      allow create: if false;
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email']);
    }

    match /subscriptionRequests/{requestId} {
      allow read: if isPlatformDataReader()
        || (isSignedIn() && exists(institutePath(resource.data.instituteId))
          && (isOwner(resource.data.instituteId) || isManagedInstituteOwner(resource.data.instituteId)));
      // Payment request creation/review is server-authoritative so the owner
      // cannot choose a price, plan snapshot, reviewer state, or duplicate key.
      allow create, update, delete: if false;
    }

    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Cloud Functions write every platform operation and audit record.  These
    // are readable for accountable support work but cannot be forged or erased
    // by any client role, including Root.
    match /platform_audit/{auditId} {
      allow read: if isPlatformDataReader();
      allow write: if false;
    }

    match /platform_admin_operations/{operationId} {
      allow read, write: if false;
    }

    // Force-update metadata contains no tenant-private data and is needed before login.
    match /Config/{documentId} {
      allow get: if true;
      allow write: if isSuperAdmin();
    }

    // Existing demo telemetry behaviour is intentionally unchanged in this scoped fix.
    match /Demo_Visitors/{document=**} {
      allow read, write: if true;
    }

    match /institutes_trash/{document=**} {
      allow read: if isSuperAdmin();
    }

    match /app_users_trash/{document=**} {
      allow read: if isSuperAdmin();
    }

    // Legacy mappings and the replacement password/UID indexes are backend-only.
    match /student_login_mappings/{studentCode} {
      allow read, write: if false;
    }

    match /student_auth_logins/{documentId} {
      allow read, write: if false;
    }

    match /student_auth_accounts/{documentId} {
      allow read, write: if false;
    }

    match /student_auth_attempts/{documentId} {
      allow read, write: if false;
    }

    // Globally reserves the normalized, user-facing Student ID. Only trusted
    // Functions can claim or release an ID, so two devices cannot race a save.
    match /student_id_claims/{documentId} {
      allow read, write: if false;
    }

    // Staff credentials, global Staff-ID lookup and brute-force counters are
    // trusted-backend-only. Clients receive only a short-lived custom token.
    match /staff_auth_logins/{documentId} {
      allow read, write: if false;
    }

    match /staff_auth_accounts/{documentId} {
      allow read, write: if false;
    }

    match /staff_auth_attempts/{documentId} {
      allow read, write: if false;
    }

    // Fail closed. Every readable/writable collection must be explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
